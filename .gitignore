# ============================================
# GITIGNORE - TOKOSUBU MONOREPO
# ============================================

# ===== Node.js (Front-End & Back-End) =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# ===== Build Output (React/Vite) =====
dist/
build/
.vite/
*.tsbuildinfo

# ===== Environment Variables =====
# Jangan pernah commit file .env asli!
.env
.env.*
# Tapi izinkan file contoh (example) agar tim lain tahu variabel apa yang dibutuhkan
!.env.example
!.env.*.example

# ===== Python (AI & ML Service) =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ===== ML Artifacts & Dataset =====
# Jangan commit model yang berat atau data rahasia pemilik
apps/ml-service/artifacts/*
!apps/ml-service/artifacts/.gitkeep
data/*
!data/.gitkeep
!data/README.md

# ===== Jupyter Notebooks (DS) =====
.ipynb_checkpoints/

# ===== OS & IDE =====
.DS_Store
Thumbs.db
.idea/
.vscode/*
# Izinkan folder .vscode tertentu jika tim butuh sharing setting
!.vscode/settings.json
!.vscode/extensions.json

# ===== Logs =====
logs/
*.log

data/*
!data/.gitkeep