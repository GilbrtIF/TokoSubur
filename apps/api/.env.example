PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://tokosubur_app:password_app@localhost:5432/tokosubur
MIGRATION_DATABASE_URL=postgres://adminu:password_adminu@localhost:5432/tokosubur

JWT_SECRET=ganti_dengan_secret_lokal
JWT_EXPIRES_IN=1d
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=30000

# Kunci rahasia untuk ML service saat mengirim hasil forecast (header X-Service-Key).
# Isi dengan string acak panjang; nilai yang sama dipasang di .env ML service.
SERVICE_API_KEY=ganti_dengan_kunci_acak_panjang
