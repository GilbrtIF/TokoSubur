    {
      "name": "Authentication",
      "description": "Pengujian endpoint login pengguna (POST /api/authentications) untuk 3 akun tetap (admin, owner, co-owner).",
      "item": [
        {
          "name": "1. Login Berhasil - Admin (Simpan Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Struktur response login dan data user valid', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data).to.be.an('object');",
                  "  pm.expect(body.data.accessToken).to.be.a('string').and.not.be.empty;",
                  "  pm.expect(body.data.user).to.deep.include({",
                  "    id: 1,",
                  "    username: 'admin',",
                  "    name: 'Administrator Sistem',",
                  "    role: 'admin'",
                  "  });",
                  "  pm.expect(body.data.user).to.not.have.property('password_hash');",
                  "});",
                  "",
                  "pm.test('Payload JWT memuat id dan role yang sesuai', function () {",
                  "  const token = pm.response.json().data.accessToken;",
                  "  const parts = token.split('.');",
                  "  pm.expect(parts).to.have.lengthOf(3);",
                  "  const base64Payload = parts[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "  const payload = JSON.parse(atob(base64Payload));",
                  "  pm.expect(payload.id).to.eql(1);",
                  "  pm.expect(payload.role).to.eql('admin');",
                  "  pm.environment.set('token', token);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/authentications",
              "host": ["{{baseUrl}}"],
              "path": ["api", "authentications"]
            }
          }
        },
