      "name": "Stocks",
      "description": "Pengujian endpoint pemantauan stok per SKU dari v_stok_saat_ini (Dataset v7: 190 SKU).",
      "item": [
        {
          "name": "1. Get Stocks - Default (Tanpa Filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Struktur response dan meta default (190 SKU) valid', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data).to.be.an('array').with.lengthOf(50);",
                  "  pm.expect(body.meta).to.deep.include({ limit: 50, offset: 0, total: 190 });",
                  "});",
                  "",
                  "pm.test('Tipe data numeric dikonversi menjadi number', function () {",
                  "  const firstItem = pm.response.json().data[0];",
                  "  pm.expect(firstItem.productId).to.be.a('number');",
                  "  pm.expect(firstItem.currentStock).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stocks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stocks"]
            }
          }
        },
        {
          "name": "2. Get Stocks - Filter Induk Karung 50 kg (isSellable=false)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Mengembalikan 4 induk karung 50 kg bersatuan kg', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.meta.total).to.eql(4);",
                  "  pm.expect(body.data).to.have.lengthOf(4);",
                  "  body.data.forEach(function (row) {",
                  "    pm.expect(row.isSellable).to.eql(false);",
                  "    pm.expect(row.isIndukPemecahan).to.eql(true);",
                  "    pm.expect(row.satuanStok).to.eql('kg');",
                  "    pm.expect(row.currentStock).to.be.a('number');",
                  "  });",
                  "});"
                ]
              }
            }
