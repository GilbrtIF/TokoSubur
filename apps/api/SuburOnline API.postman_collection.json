        {
          "name": "4. Get Stocks - Pencarian Kata Kunci (urea)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Semua hasil mengandung kata kunci urea (case-insensitive)', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.length).to.be.above(0);",
                  "  body.data.forEach(function (row) {",
                  "    const combined = [row.sku, row.nama, row.namaInduk].join(' ').toLowerCase();",
                  "    pm.expect(combined).to.include('urea');",
                  "  });",
                  "",
                  "  const repackChild = body.data.find(function (row) {",
                  "    return row.skuInduk === 'UREA50KG' && row.isSellable === true;",
                  "  });",
                  "  if (repackChild) {",
                  "    pm.environment.set('testChildSku', repackChild.sku);",
                  "  }",
                  "});"
                ]
              }
            }
