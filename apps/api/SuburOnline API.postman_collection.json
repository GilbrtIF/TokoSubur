                  "pm.test('Mengembalikan 4 induk karung 50 kg bersatuan kg', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.meta.total).to.eql(4);",
                  "  pm.expect(body.data).to.have.lengthOf(4);",
                  "  body.data.forEach(function (row) {",
                  "    pm.expect(row.isSellable).to.eql(false);",
                  "    pm.expect(row.isIndukPemecahan).to.eql(true);",
                  "    pm.expect(row.satuanStok).to.eql('kg');",
                  "    pm.expect(row.currentStock).to.be.a('number');",
