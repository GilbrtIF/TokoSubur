          "name": "1. Get Stocks - Default (Tanpa Filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status HTTP 200 OK', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Struktur response dan meta default (190 SKU) valid', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('success');",
                  "  pm.expect(body.data).to.be.an('array').with.lengthOf(50);",
                  "  pm.expect(body.meta).to.deep.include({ limit: 50, offset: 0, total: 190 });",
                  "});",
                  "",
                  "pm.test('Tipe data numeric dikonversi menjadi number', function () {",
                  "  const firstItem = pm.response.json().data[0];",
                  "  pm.expect(firstItem.productId).to.be.a('number');",
                  "  pm.expect(firstItem.currentStock).to.be.a('number');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/stocks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stocks"]
            }
